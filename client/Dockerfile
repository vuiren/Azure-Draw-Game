FROM node:20 AS build
ARG VITE_API_URL
ARG VITE_DOT_RADIUS=4
ARG VITE_POINTS_SEND_INTERVAL_MS=10
ARG VITE_POINTER_SEND_INTERVAL_MS=2
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_DOT_RADIUS=$VITE_DOT_RADIUS
ENV VITE_POINTS_SEND_INTERVAL_MS=$VITE_POINTS_SEND_INTERVAL_MS
ENV VITE_POINTER_SEND_INTERVAL_MS=$VITE_POINTER_SEND_INTERVAL_MS
WORKDIR /app
COPY . .
RUN npm install && npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html